---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { liveAppCount } from '../data/apps';
import type { Lang } from '../i18n/ui';

// 기본 OG 카드(1200×630). 앱 랜딩은 세로 스크린샷을 넘기므로 크기 메타를 붙이지 않는다.
const DEFAULT_OG = 'https://pifl-labs.com/pifl-ship-og.jpg';

interface Alternate { hreflang: string; href: string }
interface Props {
  lang: Lang;
  title: string;
  description: string;
  canonical: string;
  keywords?: string;
  alternates: Alternate[];
  ogImage?: string;
  extraCss?: string[];
}

const {
  lang, title, description, canonical, alternates,
  keywords = 'PiFl Labs, Flutter, App Development, Cross-platform, iOS, Android, Software Development',
  ogImage = DEFAULT_OG,
  extraCss = [],
} = Astro.props;

const ogLocale = lang === 'ko' ? 'ko_KR' : lang === 'ja' ? 'ja_JP' : 'en_US';
// Organization 설명 — 언어별 + 라이브 앱 수는 apps.ts 에서 파생(수동 숫자 금지).
const orgDescription = lang === 'ko'
  ? `사람 하나와 앵무새 하나의 Flutter 스튜디오. 앱 ${liveAppCount}개가 iOS · Android에서 항해 중입니다.`
  : lang === 'ja'
    ? `人ひとり、オウム一羽のFlutterスタジオ。${liveAppCount}つのアプリが iOS · Android で公開中です。`
    : `A one-human, one-parrot Flutter studio already at sea, with ${liveAppCount} apps shipping on iOS and Android.`;
const fontCss = lang === 'ja' ? '/fonts-pretendard-jp.css' : '/fonts-pretendard-kren.css';
const preloadFont = lang === 'ja' ? '/fonts/PretendardJPVariable.woff2' : '/fonts/PretendardVariable.woff2';
---
<!DOCTYPE html>
<html lang={lang}>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#020617" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="google-site-verification" content="38LJlsbWZHqmzSXNKyybWTFcuVzx8UyajrWhdi8-gAw" />

<link rel="canonical" href={canonical} />
{alternates.map((a) => (
  <link rel="alternate" hreflang={a.hreflang} href={a.href} />
))}

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{ogImage === DEFAULT_OG && (
  <>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>
)}
<meta property="og:site_name" content="PiFl Labs" />
<meta property="og:locale" content={ogLocale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

<link rel="preload" as="font" type="font/woff2" href={preloadFont} crossorigin />
<link rel="preload" as="font" type="font/woff2" href="/fonts/SpaceGrotesk-Variable.woff2" crossorigin />
<link rel="stylesheet" href={fontCss} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,700;0,9..144,900;1,9..144,700&family=Caveat:wght@500;700&family=Gowun+Batang:wght@400;700&family=Gaegu:wght@400;700&family=Shippori+Mincho:wght@400;700;800&family=Yomogi&display=swap" rel="stylesheet" />

<link rel="stylesheet" href="/colors_and_type.css" />
<link rel="stylesheet" href="/styles-stickerbook.css" />
{extraCss.map((href) => (<link rel="stylesheet" href={href} />))}

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'PiFl Labs Co., Ltd.',
  url: 'https://pifl-labs.com',
  logo: 'https://pifl-labs.com/emblem.png',
  description: orgDescription,
  email: 'hello@pifl-labs.com',
  foundingDate: '2026',
  knowsLanguage: ['ko', 'en', 'ja'],
})} />

<script is:inline src="/theme-init.js"></script>
</head>
<body>
<Nav lang={lang} />
<slot />
<Footer lang={lang} />
<script is:inline src="/script.js"></script>
</body>
</html>

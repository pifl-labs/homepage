---
// /go/tiktok — TikTok 프로필 바이오 전용 link-in-bio 허브 (noindex).
// 스토어 링크는 src/data/apps.ts(SSOT)에서 파생, 캠페인 태깅만 여기서 부여:
//   iOS  → App Store campaign token(ct=tiktok_bio_*), pt는 ASC provider ID 확보 시 추가
//   AOS  → Play install referrer(utm_source=tiktok)
// OS 감지(/go-tiktok.js)로 관련 스토어 버튼만 노출. CSP script-src 'self' 준수.
import { appName, apps } from '../../data/apps';

// App Store Connect provider ID (App Analytics 캠페인 귀속용).
// 출처: ASC olympus 세션 API providerId=128720089 (PiFl Labs Co., Ltd., 2026-07-06 확인).
// 귀속 데이터가 안 잡히면 ASC 추세>캠페인 링크 생성기에서 pt 재확인할 것 (캠페인당 5다운로드+부터 표시).
const APPLE_PT = '128720089';

// 일본어 바이오 허브 — ja 로컬라이즈가 끝난 라이브 앱만.
// 제외: pipi-word-voyage(ko 단독 소프트런치, ja는 UI 뼈대), dialogos(미출시).
const ORDER = ['pipi-words', 'pipi-hello', 'pipi-dday', 'pipi-focus', 'pipi-log', 'pipi-draw'] as const;

function iosUrl(storeUrl: string, key: string): string {
  const id = storeUrl.match(/id(\d+)/)?.[1] ?? '';
  const pt = APPLE_PT ? `pt=${APPLE_PT}&` : '';
  return `https://apps.apple.com/app/id${id}?${pt}ct=tiktok_bio_${key}&mt=8`;
}
function playUrlFor(storeUrl: string, key: string): string {
  const pkg = storeUrl.match(/id=([\w.]+)/)?.[1] ?? '';
  const referrer = encodeURIComponent(
    `utm_source=tiktok&utm_medium=social&utm_campaign=bio_${key}`,
  );
  return `https://play.google.com/store/apps/details?id=${pkg}&referrer=${referrer}`;
}

const cards = ORDER.map((slug) => {
  const app = apps[slug];
  const key = slug.replace('pipi-', '');
  return {
    slug,
    name: appName(app, 'ja'),
    category: app.category.ja,
    tagline: app.content.ja.tagline.replace(/\n/g, ' '),
    ios: app.stores.ios ? iosUrl(app.stores.ios, key) : null,
    android: app.stores.android ? playUrlFor(app.stores.android, key) : null,
  };
});
---
<!doctype html>
<html lang="ja" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>PiPi Apps — PiFl Labs</title>
    <meta name="description" content="PiPiのアプリ — 集中・単語・こども韓国語・記念日・気分日記・ぬりえ。iOS / Android." />
    <meta property="og:title" content="PiPi Apps — PiFl Labs" />
    <meta property="og:image" content="https://pifl-labs.com/pifl-ship-og.jpg" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="stylesheet" href="/colors_and_type.css" />
    <script is:inline src="/go-tiktok.js"></script>
  </head>
  <body>
    <main class="hub">
      <header class="hub-head">
        <img
          src="/assets/pipi/pipi-celebrate-trim.webp"
          alt="PiPi"
          class="hub-pipi"
          width="96"
          height="96"
        />
        <h1>PiPi Apps</h1>
        <p class="hub-sub">コードする海賊オウム🦜 PiPiの無料アプリ</p>
      </header>

      <ul class="hub-list">
        {cards.map((c) => (
          <li class="hub-card">
            <div class="hub-card-head">
              <img
                src={`/assets/apps/${c.slug}/icon.webp`}
                alt=""
                width="52"
                height="52"
                loading="lazy"
              />
              <div>
                <h2>{c.name}</h2>
                <p class="hub-cat">{c.category}</p>
                <p class="hub-tag">{c.tagline}</p>
              </div>
            </div>
            <div class="hub-stores">
              {c.ios && (
                <a class="store-btn store-ios" href={c.ios} rel="noopener">
                   App Store
                </a>
              )}
              {c.android && (
                <a class="store-btn store-android" href={c.android} rel="noopener">
                  ▶ Google Play
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>

      <footer class="hub-foot">
        <a href="https://pifl-labs.com/ja/">pifl-labs.com</a>
      </footer>
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    padding: 0;
    background: var(--bg-base, #020617);
    color: var(--text-primary, #f1f5ff);
    font-family:
      'Pretendard Variable',
      Pretendard,
      -apple-system,
      BlinkMacSystemFont,
      'Hiragino Kaku Gothic ProN',
      'Noto Sans JP',
      sans-serif;
  }
  .hub {
    max-width: 480px;
    margin: 0 auto;
    padding: 40px 20px 48px;
  }
  .hub-head {
    text-align: center;
    margin-bottom: 28px;
  }
  .hub-pipi {
    width: 96px;
    height: 96px;
    object-fit: contain;
  }
  .hub-head h1 {
    margin: 10px 0 6px;
    font-size: 1.6rem;
    letter-spacing: 0.02em;
  }
  .hub-sub {
    margin: 0;
    color: var(--text-secondary, #c0c9dd);
    font-size: 0.92rem;
  }
  .hub-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .hub-card {
    background: var(--bg-card, #111b32);
    border: 1px solid rgba(99, 102, 241, 0.22);
    border-radius: 16px;
    padding: 16px;
  }
  .hub-card-head {
    display: flex;
    gap: 14px;
    align-items: center;
  }
  .hub-card-head img {
    border-radius: 12px;
    flex: none;
  }
  .hub-card h2 {
    margin: 0;
    font-size: 1.05rem;
  }
  .hub-cat {
    margin: 2px 0 0;
    font-size: 0.75rem;
    color: var(--neon-teal, #22d3ee);
  }
  .hub-tag {
    margin: 4px 0 0;
    font-size: 0.82rem;
    color: var(--text-secondary, #c0c9dd);
  }
  .hub-stores {
    display: flex;
    gap: 10px;
    margin-top: 14px;
  }
  .store-btn {
    flex: 1;
    display: block;
    text-align: center;
    padding: 11px 0;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    color: #fff;
    background: var(--accent-cta, #6366f1);
  }
  .store-btn.store-android {
    background: var(--bg-raised, #0b1426);
    border: 1px solid rgba(34, 211, 238, 0.4);
    color: var(--neon-teal, #22d3ee);
  }
  /* OS 감지(go-tiktok.js): 해당 OS 스토어만 노출 */
  :global(html.os-ios) .store-android {
    display: none;
  }
  :global(html.os-android) .store-ios {
    display: none;
  }
  :global(html.os-ios) .store-btn.store-ios,
  :global(html.os-android) .store-btn.store-android {
    flex: 1 1 100%;
  }
  .hub-foot {
    text-align: center;
    margin-top: 28px;
  }
  .hub-foot a {
    color: var(--text-muted, #7a869f);
    font-size: 0.8rem;
    text-decoration: none;
  }
</style>

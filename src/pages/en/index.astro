---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { appList, statusLabels } from '../../data/apps';
const lang = 'en' as const;
---
<BaseLayout
  lang="en"
  title={"PiFl Labs — A crew of one parrot. Allegedly."}
  description={"A two-person Flutter studio prepping its first voyage for 2026. One codebase, two stores, zero krakens."}
  canonical="https://pifl-labs.com/en/"
  keywords={"PiFl Labs, Flutter, App Development, Cross-platform, iOS, Android, Software Development"}
  alternates={[{"hreflang":"en","href":"https://pifl-labs.com/en/"},{"hreflang":"ko","href":"https://pifl-labs.com/ko/"},{"hreflang":"ja","href":"https://pifl-labs.com/ja/"},{"hreflang":"x-default","href":"https://pifl-labs.com/ko/"}]}
  ogImage="https://pifl-labs.com/pifl-ship-og.jpg"
  extraCss={['/styles-app-landing.css']}
>
<!-- HERO -->
<section class="hero" id="top">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-copy">
        <div class="eyebrow reveal">A two-person Flutter studio · Est. 2026</div>

        <h1 class="hero-title reveal d1">
          We are a crew of <span class="italic">one</span>
          <span class="gradient">parrot</span>.<br>
          <span class="strike">Allegedly.</span>
        </h1>

        <p class="hero-lede reveal d2">
          PiFl Labs is a small studio building <em>calm, cross&#8209;platform</em> apps — one codebase, two stores, zero krakens. Prepping our first voyage with a <em>first mate</em> who wears too many hats. Literally.
        </p>

        <div class="hero-cta-row reveal d3">
          <a class="btn btn-primary" href="#crew">Meet the crew <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
          <a class="btn btn-ghost" href="#about">The story <i class="fas fa-book-open" aria-hidden="true"></i></a>
        </div>

        <div class="hero-meta reveal d4">
          <span><b>2026</b> first voyage</span>
          <span><b>iOS&nbsp;·&nbsp;Android</b></span>
          <span><b>100%</b> Flutter</span>
          <span><b>14+</b> pipi forms</span>
        </div>
      </div>

      <div class="hero-stage reveal d3">
        <div class="halo" aria-hidden="true"></div>

        <div class="star-main"><picture><source srcset="/assets/pipi/pipi-admiral.webp" type="image/webp"><img src="/assets/pipi/pipi-admiral.png" alt="PiPi, PiFl Labs mascot" width="560" height="560"></picture></div>

        <!-- 4 orbiting minis — all clean-line PNGs -->
        <div class="orbit orbit--a"><picture><source srcset="/assets/pipi/pipi-eyepatch.webp" type="image/webp"><img src="/assets/pipi/pipi-eyepatch.png" alt="" width="72" height="72"></picture></div>
        <div class="orbit orbit--b"><picture><source srcset="/assets/pipi/pipi-compass.webp" type="image/webp"><img src="/assets/pipi/pipi-compass.png" alt="" width="72" height="72"></picture></div>
        <div class="orbit orbit--c"><picture><source srcset="/assets/pipi/pipi-sailor.webp" type="image/webp"><img src="/assets/pipi/pipi-sailor.png" alt="" width="72" height="72"></picture></div>
        <div class="orbit orbit--d"><picture><source srcset="/assets/pipi/pipi-monocle.webp" type="image/webp"><img src="/assets/pipi/pipi-monocle.png" alt="" width="72" height="72"></picture></div>

        <div class="scribble scribble--main" aria-hidden="true">
          same parrot!
          <svg width="90" height="70" viewBox="0 0 90 70"><path d="M8,10 Q30,18 50,50 M50,50 L42,46 M50,50 L48,40"/></svg>
        </div>
        <div class="scribble scribble--alt" aria-hidden="true">
          <svg width="90" height="70" viewBox="0 0 90 70"><path d="M80,60 Q55,50 30,18 M30,18 L38,20 M30,18 L32,28"/></svg>
          also this one.
        </div>
      </div>
    </div>
  </div>
</section>

<!-- TICKER -->
<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    <span><b>// 01</b> Code like a pirate. <i>Fly like Flutter.</i></span>
    <span class="sep">✦</span>
    <span><b>// 02</b> One ship. Two stores. <i>No kraken.</i></span>
    <span class="sep">✦</span>
    <span><b>// 03</b> <i>Anchored in drydock</i> · charts being drawn</span>
    <span class="sep">✦</span>
    <span><b>// 04</b> <i>First voyage:</i> 2026</span>
    <span class="sep">✦</span>
    <span><b>// 05</b> Two humans. <i>One parrot.</i> Many hats.</span>
    <span class="sep">✦</span>
    <span><b>// 01</b> Code like a pirate. <i>Fly like Flutter.</i></span>
    <span class="sep">✦</span>
    <span><b>// 02</b> One ship. Two stores. <i>No kraken.</i></span>
    <span class="sep">✦</span>
    <span><b>// 03</b> <i>Anchored in drydock</i> · charts being drawn</span>
    <span class="sep">✦</span>
    <span><b>// 04</b> <i>First voyage:</i> 2026</span>
    <span class="sep">✦</span>
    <span><b>// 05</b> Two humans. <i>One parrot.</i> Many hats.</span>
    <span class="sep">✦</span>
  </div>
</div>

<!-- APPS SECTION -->
<section class="apps-home" id="apps">
  <div class="container">
    <div class="section-head">
      <div class="kicker">00 / Fleet</div>
      <h2 class="section-title">A small fleet, <span class="italic">first to sail.</span></h2>
      <p class="section-sub">
        The apps PiPi makes. One codebase, two stores — quiet, but made with care.
      </p>
    </div>
    <div class="app-card-grid">
      {appList.map((app) => (
        <a class="app-card" href={`/${lang}/apps/${app.slug}/`}>
          <img class="app-card-icon" src={`/assets/apps/${app.slug}/icon.webp`} alt={`${app.name} icon`} width="64" height="64" loading="lazy" />
          <div class="app-card-body">
            <div class="app-card-head">
              <span class="app-card-name">{app.name}</span>
              <span class={`app-card-status app-card-status--${app.status}`}>{statusLabels[lang][app.status]}</span>
            </div>
            <span class="app-card-cat">{app.category[lang]}</span>
            <p class="app-card-tag">{app.content[lang].tagline}</p>
          </div>
          <span class="app-card-go" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- CREW SECTION -->
<section class="crew-section" id="crew">
  <div class="container">
    <div class="section-head">
      <div class="kicker">01 / The Manifest</div>
      <h2 class="section-title">Meet the entire crew. <span class="italic">It's one bird.</span></h2>
      <p class="section-sub">
        PiPi, our first mate, does fourteen jobs. Captain, cartographer, cheerleader, and yes — the one in the hammock. Every hat is a context she gets pulled into. Tap one.
      </p>
    </div>

    <div class="sticker-wall">
      <div class="sticker sticker--clean"><picture><source srcset="/assets/pipi/pipi-admiral.webp" type="image/webp"><img src="/assets/pipi/pipi-admiral.png" alt="" loading="lazy"></picture><span class="label">Admiral</span></div>
      <div class="sticker sticker--clean"><picture><source srcset="/assets/pipi/pipi-helm-trim.webp" type="image/webp"><img src="/assets/pipi/pipi-helm-trim.png" alt="" loading="lazy"></picture><span class="label">Helmsman</span></div>
      <div class="sticker sticker--clean"><picture><source srcset="/assets/pipi/pipi-explorer-trim.webp" type="image/webp"><img src="/assets/pipi/pipi-explorer-trim.png" alt="" loading="lazy"></picture><span class="label">Scout</span></div>
      <div class="sticker sticker--clean"><picture><source srcset="/assets/pipi/pipi-compass.webp" type="image/webp"><img src="/assets/pipi/pipi-compass.png" alt="" loading="lazy"></picture><span class="label">Navigator</span></div>
      <div class="sticker sticker--clean"><picture><source srcset="/assets/pipi/pipi-monocle.webp" type="image/webp"><img src="/assets/pipi/pipi-monocle.png" alt="" loading="lazy"></picture><span class="label">Inspector</span></div>
      <div class="sticker sticker--clean"><picture><source srcset="/assets/pipi/pipi-celebrate-trim.webp" type="image/webp"><img src="/assets/pipi/pipi-celebrate-trim.png" alt="" loading="lazy"></picture><span class="label">Morale</span></div>
      <div class="sticker sticker--clean"><picture><source srcset="/assets/pipi/pipi-eyepatch.webp" type="image/webp"><img src="/assets/pipi/pipi-eyepatch.png" alt="" loading="lazy"></picture><span class="label">Rogue</span></div>
      <div class="sticker sticker--clean"><picture><source srcset="/assets/pipi/pipi-king.webp" type="image/webp"><img src="/assets/pipi/pipi-king.png" alt="" loading="lazy"></picture><span class="label">Royalty</span></div>
      <div class="sticker sticker--clean"><picture><source srcset="/assets/pipi/pipi-sailor.webp" type="image/webp"><img src="/assets/pipi/pipi-sailor.png" alt="" loading="lazy"></picture><span class="label">Deckhand</span></div>
      <div class="sticker sticker--clean"><picture><source srcset="/assets/pipi/pipi-skull.webp" type="image/webp"><img src="/assets/pipi/pipi-skull.png" alt="" loading="lazy"></picture><span class="label">Jolly</span></div>
      <div class="sticker sticker--clean"><picture><source srcset="/assets/pipi/pipi-wink-trim.webp" type="image/webp"><img src="/assets/pipi/pipi-wink-trim.png" alt="" loading="lazy"></picture><span class="label">Relay</span></div>
      <div class="sticker sticker--clean"><picture><source srcset="/assets/pipi/pipi-hammock-trim.webp" type="image/webp"><img src="/assets/pipi/pipi-hammock-trim.png" alt="" loading="lazy"></picture><span class="label">Off-duty</span></div>
    </div>

    <div class="annotation-strip">
      <i class="fas fa-arrow-up" aria-hidden="true"></i>
      <span>That's <em>not</em> twelve parrots. That's one parrot, twelve deadlines.</span>
    </div>
  </div>
</section>

<!-- CURRENTLY -->
<section class="currently" aria-label="Company status">
  <div class="container">
    <div class="currently-inner">
      <div class="currently-pipi">
        <picture><source srcset="/assets/pipi/pipi-king.webp" type="image/webp"><img src="/assets/pipi/pipi-king.png" alt="" loading="lazy"></picture>
        <div class="currently-bubble">Still below deck 🔭</div>
      </div>
      <div>
        <div class="currently-meta">● Currently</div>
        <div class="currently-text">
          Heads down, sails up. Prepping our <b>first voyage for 2026</b>. Trademark pending. No launch dates — just a crew, a codebase, and a lot of coffee.
        </div>
      </div>
      <div class="currently-badge">Live log</div>
    </div>
  </div>
</section>

<!-- ABOUT / LOGBOOK -->
<section class="about" id="about">
  <div class="container">
    <div class="section-head">
      <div class="kicker">02 / The Name</div>
      <h2 class="section-title">Two syllables. <span class="italic">One dumb joke.</span></h2>
    </div>

    <div class="about-wrap">
      <div class="logbook-card">
        <div class="logbook-date">
          <span>Captain's Log · Entry 001</span><span>26° ENE · fair winds</span>
        </div>
        <div class="logbook-entry">
          <p>We wanted a name that was half math, half nonsense. <strong>Pi</strong> for the endless loop of software. <strong>Fl</strong> for the framework that lets one codebase fly across every platform.</p>
          <p>Put them together and you get <strong>PiFl</strong> — which, read fast, sounds like a pirate with a lisp. Good. That's on-brand.</p>
          <p>Our first mate is a parrot who codes. She has fourteen hats. She wears them all at once, somehow.</p>
        </div>
        <div class="logbook-signature">— the crew</div>
      </div>

      <div class="decoder-stack">
        <div class="decoder">
          <div class="glyph">π</div>
          <div>
            <h3>Pi</h3>
            <p>The endless loop. Mathematics, logic, and the comfort of infinity in a single symbol.</p>
          </div>
        </div>
        <div class="decoder">
          <div class="glyph">Fl</div>
          <div>
            <h3>Fl — for Flutter</h3>
            <p>One codebase. iOS, Android, web, desktop. Wings included, batteries included.</p>
          </div>
        </div>
        <div class="decoder">
          <div class="glyph">⚓</div>
          <div>
            <h3>Labs</h3>
            <p>Because "studio" sounds too precious and "corp" sounds too big. Labs ship scrappy.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- PULL QUOTE -->
<section class="pull">
  <div class="container">
    <p class="quote">
      We build <span class="highlight">calm apps</span><br>
      with a <span class="highlight">pirate spirit</span>.<br>
      One codebase, two stores.<br>
      Zero krakens.
    </p>
    <div class="quote-by">
      <picture><source srcset="/assets/pipi/pipi-sailor.webp" type="image/webp"><img src="/assets/pipi/pipi-sailor.png" alt="" loading="lazy"></picture> — PiPi, first mate
    </div>
  </div>
</section>

<!-- LOG / DISPATCHES -->
<section class="join" id="log">
  <div class="container">
    <div class="section-head">
      <div class="kicker">03 / Dispatches</div>
      <h2 class="section-title">From the log. <span class="italic">Quiet but moving.</span></h2>
      <p class="section-sub">
        We're not live yet. We're <em>getting there.</em> Here's what's on deck this season.
      </p>
    </div>

    <div class="dispatch-grid">
      <article class="dispatch dispatch--live">
        <div class="dispatch-head">
          <span class="slot-tag">Entry · this season</span>
        </div>
        <div class="dispatch-art"><picture><source srcset="/assets/pipi/pipi-admiral.webp" type="image/webp"><img src="/assets/pipi/pipi-admiral.png" alt="" loading="lazy"></picture></div>
        <div class="dispatch-body">
          <div class="slot-role">Chart <span class="italic">the route</span></div>
          <div class="slot-desc">Sketching the shape of our first apps. Calm on purpose. Short on features, long on care.</div>
        </div>
      </article>

      <article class="dispatch dispatch--next">
        <div class="dispatch-head">
          <span class="slot-tag">Entry · next</span>
        </div>
        <div class="dispatch-art"><picture><source srcset="/assets/pipi/pipi-monocle.webp" type="image/webp"><img src="/assets/pipi/pipi-monocle.png" alt="" loading="lazy"></picture></div>
        <div class="dispatch-body">
          <div class="slot-role">Rig <span class="italic">the ship</span></div>
          <div class="slot-desc">Design system, modular Dart, icon grids. The plumbing no one applauds but everyone relies on.</div>
        </div>
      </article>

      <article class="dispatch dispatch--soon">
        <div class="dispatch-head">
          <span class="slot-tag">Entry · soon</span>
        </div>
        <div class="dispatch-art"><picture><source srcset="/assets/pipi/pipi-compass.webp" type="image/webp"><img src="/assets/pipi/pipi-compass.png" alt="" loading="lazy"></picture></div>
        <div class="dispatch-body">
          <div class="slot-role">Set <span class="italic">sail</span></div>
          <div class="slot-desc">When the wind is right and the charts are readable. 2026. No earlier, no later.</div>
        </div>
      </article>
    </div>

    <div class="join-cta">
      <a class="btn btn-primary btn-large" href="#" data-email-user="hello" data-email-domain="pifl-labs.com"><i class="fas fa-envelope" aria-hidden="true"></i> Say hi</a>
      <p class="hint">We like a good postcard — <a href="#" data-email-user="hello" data-email-domain="pifl-labs.com"><span class="email-text"></span></a></p>
    </div>
  </div>
</section>

<!-- FOOTER -->
</BaseLayout>

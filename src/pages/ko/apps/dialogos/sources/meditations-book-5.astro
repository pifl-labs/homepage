  title={"명상록 · 제5권 — Dialogos 출처 | PiFl Labs"}
  description={"마르쿠스 아우렐리우스 《명상록》 제5권 소개와, 직접 읽을 수 있는 퍼블릭 도메인(저작권 만료) 원문 안내. Dialogos가 인용하는 스토아 철학 출처."}
  canonical="https://pifl-labs.com/ko/apps/dialogos/sources/meditations-book-5/"
  alternates={[{"hreflang":"en","href":"https://pifl-labs.com/en/apps/dialogos/sources/meditations-book-5/"},{"hreflang":"ko","href":"https://pifl-labs.com/ko/apps/dialogos/sources/meditations-book-5/"},{"hreflang":"ja","href":"https://pifl-labs.com/ja/apps/dialogos/sources/meditations-book-5/"},{"hreflang":"x-default","href":"https://pifl-labs.com/ko/apps/dialogos/sources/meditations-book-5/"}]}

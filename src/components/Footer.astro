---
import { ui, localeBase, type Lang } from '../i18n/ui';
import { appName, liveApps } from '../data/apps';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const base = localeBase(lang);
const home = `${base}/`;
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href={home}>
          <picture><source srcset="/emblem.webp" type="image/webp"><img src="/emblem.png" alt="" width="32" height="32"></picture>
          <b>PiFl Labs</b><sup>{t.co}</sup>
        </a>
        <p class="footer-tagline">{t.footTagline}</p>
        <p class="footer-desc">{t.footDesc}</p>
        <div class="footer-grant">
          <a class="cartesia-startups" href="https://www.cartesia.ai/startups" aria-label="Cartesia Startups Grant" aria-describedby="footer-cartesia-note">
            <img class="cartesia-startups-light" src="/assets/partners/cartesia-startups-primary.svg" alt="" width="604" height="62" loading="lazy" />
            <img class="cartesia-startups-dark" src="/assets/partners/cartesia-startups-white.svg" alt="" width="311" height="32" loading="lazy" />
          </a>
          <p class="footer-grant-note" id="footer-cartesia-note">{t.footCartesiaGrant}</p>
        </div>
      </div>
      <div class="footer-col">
        <h4>{t.footNavigate}</h4>
        <ul>
          <li><a href={home}>{t.footHome}</a></li>
          <li><a href={`/${lang}/archive/`}>{({ko:"PiFl Labs 기록관",ja:"PiFl Labs 記録館",en:"PiFl Labs Archive"})[lang]}</a></li>
          <li><a href={`${home}#crew`}>{t.navCrew}</a></li>
          <li><a href={`${home}#about`}>{t.navShip}</a></li>
          <li><a href={`${home}#log`}>{t.navLog}</a></li>
          <li><a href={`https://tools.pifl-labs.com/${lang}/`} target="_blank" rel="noopener">{t.footTools} ↗</a></li>
          <li><a href={`https://pipi-worlds.com/${lang}/`} target="_blank" rel="noopener">{t.footWorlds} ↗</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>{t.navApps}</h4>
        <ul>
          {liveApps.map((app) => (
            <li><a href={`/${lang}/apps/${app.slug}/`}>{appName(app, lang)}</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-col">
        <h4>{t.footContact}</h4>
        <ul>
          <li><a href="#" data-email-user="hello" data-email-domain="pifl-labs.com"><span class="email-text">hello (at) pifl-labs.com</span></a></li>
          <li><a href="#" data-email-user="privacy" data-email-domain="pifl-labs.com"><span class="email-text">privacy (at) pifl-labs.com</span></a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>{t.copyright}</span>
      <span><a href={`${base}/terms/`}>{t.terms}</a> · <a href={`${base}/privacy/`}>{t.privacy}</a> · Made with ⚓</span>
    </div>
  </div>
  <picture><source srcset="/assets/pipi/pipi-sleepy-trim.webp" type="image/webp"><img src="/assets/pipi/pipi-sleepy-trim.png" alt="" width="256" height="256" class="footer-sleep" aria-hidden="true" loading="lazy"></picture>
  <div class="footer-prefs">
    <div class="pref-group">
      <span class="pref-label">{t.theme}</span>
      <div class="pref-row" role="group" aria-label={t.theme}>
        <button type="button" class="pref-btn" data-theme-btn="auto" aria-pressed="false">{t.themeAuto}</button>
        <button type="button" class="pref-btn" data-theme-btn="light" aria-pressed="false">{t.themeLight}</button>
        <button type="button" class="pref-btn" data-theme-btn="dark" aria-pressed="false">{t.themeDark}</button>
      </div>
    </div>
    <div class="pref-group">
      <span class="pref-label">{t.textSize}</span>
      <div class="pref-row" role="group" aria-label={t.textSize}>
        <button type="button" class="pref-btn pref-btn-ts" data-ts-btn="normal" aria-pressed="false" aria-label={t.tsNormal}>{t.tsGlyph}</button>
        <button type="button" class="pref-btn pref-btn-ts" data-ts-btn="large" aria-pressed="false" aria-label={t.tsLarge}>{t.tsGlyph}</button>
        <button type="button" class="pref-btn pref-btn-ts" data-ts-btn="xlarge" aria-pressed="false" aria-label={t.tsXlarge}>{t.tsGlyph}</button>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-grant { margin-top: .75rem; }
  .cartesia-startups {
    display: inline-flex;
    align-items: center;
    width: 192px;
    max-width: 100%;
    min-height: 44px;
    vertical-align: top;
  }
  .cartesia-startups img { width: 100%; height: auto; }
  /* Follow the resolved site theme, not the OS preference alone. */
  .cartesia-startups-light { display: none; }
  .cartesia-startups-dark { display: block; }
  :global(html[data-theme="light"]) .cartesia-startups-light { display: block; }
  :global(html[data-theme="light"]) .cartesia-startups-dark { display: none; }
  .footer-grant-note {
    margin: .375rem 0 0;
    color: var(--text-secondary);
    font-size: .875rem;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .footer-grant-note:lang(ko) { word-break: keep-all; }
</style>

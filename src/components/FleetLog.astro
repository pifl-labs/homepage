---
import '../styles/words-release-contrast.css';
import { appIconSrc } from "../data/app-icons.mjs";
// 함대 정비 기록 — 홈 #log 아래에 붙는 "실제로 지금 스토어에 올라간 버전" 섹션.
// 모든 숫자·날짜는 src/data/apps.ts 의 실측 release 데이터에서 파생한다(하드코딩 금지).
import {
  appName, formatDate,
  latestUpdate, liveApps, homeReleaseApps, releaseObservationDates,
} from '../data/apps';
import { publicArchiveEvents } from '../data/archive-public.mjs';
import { archiveCopy } from '../data/archive-copy';
import { japaneseAppNameParts, japaneseReadingParts } from './app-name-parts.mjs';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;

// 최신 정비 순 정렬 — "지금 무엇이 움직이고 있나"가 먼저 보이도록.
const publicDate = (app, platform) =>
  publicArchiveEvents.find(e => e.app===app.slug && e.platform===platform && e.version===app.release?.[platform]?.version)?.publication;
const latestDisplayed = app => ['ios','android'].map(platform=>publicDate(app,platform)?.date).filter(Boolean).sort().at(-1) || latestUpdate(app);
const rows = [...homeReleaseApps].sort((a, b) => latestDisplayed(b).localeCompare(latestDisplayed(a)));

// 서로 다른 앱의 관측일을 모두 오늘 확인한 것처럼 보이지 않게 범위로 표시한다.
const checkedDates = [...new Set(liveApps.flatMap(releaseObservationDates))].sort();
const rangeDates = checkedDates.length
  ? [checkedDates[0], checkedDates.at(-1)!].filter((date, i, dates) => i === 0 || date !== dates[0])
  : [];

const copy = {
  ko: {
    noteBefore: '스토어 실측 · ', noteAfter: ' 확인',
  },
  ja: {
    noteBefore: 'ストア実測 · ', noteAfter: ' 確認',
  },
  en: {
    noteBefore: 'Checked against the stores on ', noteAfter: '',
  },
}[lang];
---
<section class="fleet-log-section" id="fleet">
  <div class="container">
    <details class="fleet-disclosure">
      <summary>{({ ko: '마지막으로 확인한 스토어 버전', ja: '最後に確認したストアバージョン', en: 'Last checked store versions' })[lang]}</summary>
      <p class="section-sub">{({ko:"이 목록은 마지막 확인 상태표입니다. 전체 연혁은 기록관에서 확인하세요.",ja:"この一覧は最後に確認した状態です。過去の歩みは記録館をご覧ください。",en:"This is the last checked status, not a complete version history. Explore the archive for earlier records."})[lang]} <a href={`/${lang}/archive/`}>{({ko:"기록관 보기 →",ja:"記録館へ →",en:"Explore the archive →"})[lang]}</a></p>

    <ol class="fleet-log">
      {rows.map((app) => {
        const r = app.release!;
        const platforms = (['ios','android'] as const).filter(platform => app.stores[platform] && r[platform]?.version);
        const dates = archiveCopy[lang].dates;
        return (
          <li class="fleet-row">
            <a class="fleet-link" href={`/${lang}/apps/${app.slug}/`}>
              <img class="fleet-icon" src={appIconSrc(app.slug)} alt="" width="44" height="44" loading="lazy" />
              <span class="fleet-main">
                <span class="fleet-name">{lang === 'ja' ? japaneseAppNameParts(appName(app, lang)).map((part: { text: string; keepWhole: boolean }) => part.keepWhole ? <span class="app-name-part ja-reading-unit">{part.text}</span> : part.text) : appName(app, lang)}</span>
                <span class="fleet-cat">{lang === 'ja' ? japaneseReadingParts(app.category[lang], 'category').map(part => part.keepWhole ? <span class="ja-reading-unit">{part.text}</span> : part.text) : app.category[lang]}</span>
              </span>
              <span class="fleet-meta">
                {platforms.map(platform => {
                  const version = r[platform]!.version;
                  const published = publicDate(app,platform);
                  return <span class="fleet-store-version" data-fleet-platform={platform}>
                    <span class="fleet-chip" style="color: var(--text-primary)">{platform==='ios'?'iOS':'Android'} v{version}</span>
                    {published && <span class="fleet-date">{dates[published.basis].replace(/^iOS|^Android · /,'').trim()} <time datetime={published.date}>{published.date}</time></span>}
                  </span>;
                })}
              </span>
            </a>
          </li>
        );
      })}
    </ol>

    <p class="fleet-note">{copy.noteBefore}{rangeDates.map((date, i) => <>{i > 0 && ' – '}<time datetime={date} style="white-space: nowrap">{formatDate(date, lang)}</time></>)}{copy.noteAfter}</p>
    </details>
  </div>
</section>

<style is:global>
  .fleet-store-version { display: flex; align-items: baseline; flex-wrap: wrap; justify-content: inherit; gap: .2rem .45rem; min-width: 0; }
  .fleet-store-version .fleet-date time { white-space: nowrap; }
  /* Keep the shared dated observation readable in both supported themes. */
  .fleet-log-section .fleet-note { color: var(--text-secondary); }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScrollableLegalTable from '../ScrollableLegalTable.astro';
import type { Lang } from '../../i18n/ui';

interface Props { lang?: Lang; homeHref?: string }
// 한칸씩 스도쿠는 한국어·영어·일본어로 출시한다. 형제 앱처럼 로케일 경로마다 그 언어 본문 하나만
// 서빙한다(자기 canonical + ko/en/ja alternate, x-default 는 사이트 규칙대로 /ko/).
// 무prefix 레거시 경로는 영어 본문을 렌더한다(canonical /en/).
// 일본어판은 니콜리 등록상표인 「数独」「SUDOKU」를 쓰지 않고 「ナンプレ」로 표기한다.
const { lang = 'ko', homeHref = `/${lang}/` } = Astro.props;

const BASE = 'https://pifl-labs.com';
const PATH = '/apps/pipi-sudoku/privacy/';
const canonical = `${BASE}/${lang}${PATH}`;
const alternates = [
  { hreflang: 'en', href: `${BASE}/en${PATH}` },
  { hreflang: 'ko', href: `${BASE}/ko${PATH}` },
  { hreflang: 'ja', href: `${BASE}/ja${PATH}` },
  { hreflang: 'x-default', href: `${BASE}/ko${PATH}` },
];

const chrome = {
  ko: {
    docTitle: '한칸씩 스도쿠 개인정보처리방침 - PiFl Labs',
    docDesc: '계정, 광고, 인앱 결제, 분석·추적 도구 없이 오프라인으로 동작하는 한칸씩 스도쿠의 개인정보처리방침입니다.',
    back: '홈으로 돌아가기',
    title: '한칸씩 스도쿠 개인정보처리방침',
    date: '시행일: 2026년 10월 13일',
  },
  en: {
    docTitle: 'Cell by Cell Sudoku Privacy Policy - PiFl Labs',
    docDesc: 'Privacy policy for Cell by Cell Sudoku, which works offline with no account, ads, in-app purchases, or analytics and tracking tools.',
    back: 'Back to Home',
    title: 'Cell by Cell Sudoku Privacy Policy',
    date: 'Effective Date: October 13, 2026',
  },
  ja: {
    docTitle: 'ひとマスずつナンプレ プライバシーポリシー - PiFl Labs',
    docDesc: 'アカウント、広告、アプリ内課金、分析・トラッキングツールなしでオフラインで動作する「ひとマスずつナンプレ」のプライバシーポリシーです。',
    back: 'ホームに戻る',
    title: 'ひとマスずつナンプレ プライバシーポリシー',
    date: '施行日: 2026年10月13日',
  },
}[lang];
---
<BaseLayout
  lang={lang}
  title={chrome.docTitle}
  description={chrome.docDesc}
  canonical={canonical}
  alternates={alternates}
  extraCss={["/styles.css"]}
>
  <section class="legal-hero">
    <div class="container">
      <a href={homeHref} class="legal-back"><i class="fas fa-arrow-left" aria-hidden="true"></i> {chrome.back}</a>
      <h1><i class="fas fa-shield-alt" aria-hidden="true"></i> <span class="text-gradient">{chrome.title}</span></h1>
      <p class="legal-date">{chrome.date}</p>
    </div>
  </section>

  <main id="main" class="legal-page">
    <div class="container">
      {lang === 'ko' && (
      <div class="legal-card">
        <p>주식회사 피플랩스(이하 "회사")는 「개인정보 보호법」 제30조에 따라 정보주체의 개인정보를 보호하고 이와 관련한 고충을 신속하고 원활하게 처리할 수 있도록 하기 위하여, 오프라인으로 9×9 스도쿠를 푸는 모바일 애플리케이션 <strong>한칸씩 스도쿠</strong>(이하 "앱")에 대한 개인정보 처리방침을 다음과 같이 수립·공개합니다. 본 방침은 회사 웹사이트의 <a href="/ko/privacy/">통합 개인정보처리방침</a>에 우선하여 본 앱에 적용됩니다.</p>

        <p>앱은 <strong>회원가입·로그인이 없고</strong>, 광고·인앱 결제·분석 및 추적 도구(SDK)를 사용하지 않습니다. 앱은 스스로 네트워크 요청을 보내지 않으며 회사 서버에 연결하지 않습니다. <strong>퍼즐 진행 상황, 내 퍼즐, 설정은 기기 안의 앱 전용 저장 공간에만 저장되며, 회사는 이 정보를 볼 수 없습니다.</strong></p>

        <h2>제1조 (개인정보의 처리 목적)</h2>
        <ul>
          <li><strong>앱 기능 제공</strong>: 풀던 퍼즐의 진행 상태 복원(입력한 숫자와 메모, 되돌리기·다시 실행 기록, 선택한 칸), 퍼즐 팩 진행 상황과 내 퍼즐 보관, 설정 유지 — 모두 기기 안에서만 처리되며 회사로 전송되지 않습니다.</li>
          <li><strong>고객 문의 응대</strong>: 이용자가 이메일로 보낸 문의의 접수, 답변 및 처리 결과 통보</li>
        </ul>

        <h2>제2조 (처리하는 개인정보의 항목)</h2>
        <p>앱은 회원가입을 요구하지 않습니다. 앱이 기기에 저장하는 정보와 회사가 문의 응대를 위해 받는 정보는 다음과 같습니다.</p>
        <ScrollableLegalTable label="개인정보 안내 표, 가로로 스크롤할 수 있습니다">
        <table>
          <thead>
            <tr>
              <th>구분</th>
              <th>처리 항목</th>
              <th>수집 방법 · 보관 위치</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>게임 기록</td>
              <td>진행 중인 퍼즐, 입력한 숫자와 메모(후보), 되돌리기·다시 실행 기록, 선택한 칸, 퍼즐 팩 진행 상황</td>
              <td>기기 안의 앱 전용 저장 공간에만 저장. 회사로 전송되지 않으며 회사는 볼 수 없음</td>
            </tr>
            <tr>
              <td>내 퍼즐</td>
              <td>이용자가 직접 입력한 퍼즐의 주어진 숫자와 제목(선택, 40자 이내), 최대 100개</td>
              <td>기기 안의 앱 전용 저장 공간에만 저장. 회사로 전송되지 않으며 회사는 볼 수 없음</td>
            </tr>
            <tr>
              <td>앱 설정</td>
              <td>메모 자동 정리, 진동 피드백, 배경 테마(종이·정원·밤), 화면 모드</td>
              <td>기기 안의 앱 전용 저장 공간에만 저장. 회사로 전송되지 않으며 회사는 볼 수 없음</td>
            </tr>
            <tr>
              <td>이메일 문의</td>
              <td>이메일 주소, 이름(선택), 문의 내용</td>
              <td>이용자가 회사의 지원·개인정보 문의 메일로 직접 보내는 경우에 한해 수집</td>
            </tr>
          </tbody>
        </table>
        </ScrollableLegalTable>

        <h2>제3조 (개인정보의 처리 및 보유기간)</h2>
        <ul>
          <li><strong>게임 기록·내 퍼즐·앱 설정(기기 내)</strong>: 이용자가 앱을 삭제할 때까지 기기에 보관되며, 앱을 삭제하면 함께 삭제됩니다. 기기 백업에 포함되는지는 이용자의 iOS 백업 설정을 따릅니다.</li>
          <li><strong>이메일 문의 기록</strong>: 문의 처리 완료 후 <strong>3년</strong></li>
        </ul>

        <h2>제4조 (개인정보의 제3자 제공)</h2>
        <p>회사는 정보주체의 개인정보를 제3자에게 제공하지 않습니다. 다만 정보주체의 동의, 법률의 특별한 규정 등 「개인정보 보호법」 제17조 및 제18조에 해당하는 경우에 한합니다.</p>

        <h2>제5조 (개인정보처리의 위탁)</h2>
        <p>회사는 본 앱과 관련한 개인정보 처리업무를 위탁하지 않습니다.</p>

        <h2>제6조 (국외 이전)</h2>
        <p>회사는 본 앱과 관련하여 개인정보를 국외로 이전하지 않습니다. 앱은 기기에 저장한 정보를 기기 밖으로 전송하지 않습니다.</p>

        <h2>제7조 (Apple이 처리하는 정보)</h2>
        <p>App Store에서 앱을 내려받는 과정, 이용자가 앱 개발자와 공유하도록 선택한 충돌·진단 보고서, TestFlight 피드백은 Apple이 <a href="https://www.apple.com/kr/legal/privacy/" target="_blank" rel="noopener">Apple의 개인정보 처리방침</a>에 따라 처리합니다.</p>

        <h2>제8조 (앱 권한 안내)</h2>
        <p>본 앱은 기기 권한을 요청하지 않습니다. 위치·카메라·마이크·연락처·사진·알림 권한을 요청하지 않으며, 추적 허용 요청(App Tracking Transparency)도 표시하지 않습니다.</p>

        <h2>제9조 (개인정보의 파기절차 및 방법)</h2>
        <ul>
          <li><strong>파기절차</strong>: 보유기간이 지나는 등 불필요해진 개인정보는 개인정보 보호책임자의 승인을 거쳐 지체 없이 파기합니다.</li>
          <li><strong>파기방법</strong>: 전자적 파일은 복원이 불가능한 방법으로 영구 삭제합니다. 기기에 저장된 게임 기록·내 퍼즐·앱 설정은 이용자가 앱을 삭제하면 기기에서 함께 삭제됩니다.</li>
        </ul>

        <h2>제10조 (정보주체의 권리·의무 및 행사방법)</h2>
        <p>정보주체(법정대리인 포함)는 회사에 대해 언제든지 다음 각 호의 개인정보 보호 관련 권리를 행사할 수 있습니다.</p>
        <ol>
          <li>개인정보 처리에 관한 정보를 제공받을 권리</li>
          <li>개인정보의 처리에 관한 동의 여부, 동의 범위 등을 선택하고 결정할 권리</li>
          <li>개인정보의 처리 여부를 확인하고 개인정보에 대하여 열람을 요구할 권리</li>
          <li>개인정보의 처리 정지, 정정·삭제 및 파기를 요구할 권리</li>
          <li>개인정보의 처리로 인하여 발생한 피해를 신속하고 공정한 절차에 따라 구제받을 권리</li>
        </ol>
        <p>위 권리 행사는 <a href="#" data-email-user="privacy" data-email-domain="pifl-labs.com"><span class="email-text">privacy (at) pifl-labs.com</span></a>로 요청하실 수 있으며, 회사는 이에 대해 지체 없이 조치하겠습니다. 기기에만 저장되는 게임 기록·내 퍼즐·앱 설정은 회사가 보관하지 않아 열람하거나 삭제해 드릴 수 없으며, 앱을 삭제하면 기기에서 지워집니다.</p>

        <h2>제11조 (개인정보의 안전성 확보조치)</h2>
        <p>회사는 개인정보의 안전성 확보를 위해 다음과 같은 조치를 취하고 있습니다.</p>
        <ul>
          <li>앱이 정보를 기기 밖으로 전송하지 않는 설계(앱 자체의 네트워크 요청 없음, 회사 서버 연결 없음)</li>
          <li>게임 기록·내 퍼즐·앱 설정을 기기의 앱 전용 저장 공간에 보관</li>
          <li>문의 메일에 대한 접근 권한 관리</li>
        </ul>

        <h2>제12조 (아동의 개인정보 보호)</h2>
        <p>앱은 이용자의 나이와 관계없이 개인정보를 수집하지 않습니다. 다만 만 14세 미만 아동이 이메일로 문의하는 경우에는 법정대리인의 동의가 필요할 수 있습니다. 회사는 법정대리인의 동의 없이 만 14세 미만 아동의 개인정보가 수집된 사실을 확인하면 지체 없이 해당 정보를 삭제합니다. 보호자는 <a href="#" data-email-user="privacy" data-email-domain="pifl-labs.com"><span class="email-text">privacy (at) pifl-labs.com</span></a>로 문의 또는 삭제를 요청하실 수 있습니다.</p>

        <h2>제13조 (개인정보 보호책임자)</h2>
        <ul>
          <li>회사명: 주식회사 피플랩스 (PiFl Labs Co., Ltd.)</li>
          <li>이메일: <a href="#" data-email-user="privacy" data-email-domain="pifl-labs.com"><span class="email-text">privacy (at) pifl-labs.com</span></a></li>
        </ul>
        <p>앱 이용 문의는 <a href="/ko/apps/pipi-sudoku/support/">지원 페이지</a> 또는 <a href="#" data-email-user="support" data-email-domain="pifl-labs.com"><span class="email-text">support (at) pifl-labs.com</span></a>로 보내 주세요.</p>

        <h2>제14조 (권익침해 구제방법)</h2>
        <p>정보주체는 개인정보침해로 인한 구제를 받기 위하여 다음 기관에 분쟁해결이나 상담 등을 신청할 수 있습니다.</p>
        <ul>
          <li>개인정보분쟁조정위원회: (국번없이) 1833-6972 (www.kopico.go.kr)</li>
          <li>개인정보침해신고센터: (국번없이) 118 (privacy.kisa.or.kr)</li>
          <li>대검찰청: (국번없이) 1301 (www.spo.go.kr)</li>
          <li>경찰청: (국번없이) 182 (ecrm.cyber.go.kr)</li>
        </ul>

        <h2>제15조 (개인정보 처리방침 변경)</h2>
        <p>이 개인정보 처리방침은 2026년 10월 13일부터 적용됩니다. 변경 사항이 있을 경우 본 페이지를 통하여 공지하겠습니다.</p>
      </div>
      )}

      {lang === 'en' && (
      <div class="legal-card">
        <p>PiFl Labs Co., Ltd. ("Company", "we", "us") has established and publishes this Privacy Policy under Article 30 of the Korean Personal Information Protection Act to protect your personal data and to handle related concerns promptly and smoothly. It covers <strong>Cell by Cell Sudoku</strong> ("App"), a mobile app for solving 9×9 sudoku puzzles offline, and applies to the App in preference to our <a href="/en/privacy/">general Privacy Policy</a>.</p>

        <p>The App has <strong>no sign-up or login</strong> and uses no ads, in-app purchases, or analytics or tracking tools (SDKs). It makes no network requests of its own and does not connect to our servers. <strong>Your puzzle progress, My Puzzles and settings are stored only in the App's private storage on your device, and we cannot see them.</strong></p>

        <h2>1. Purpose of Processing</h2>
        <ul>
          <li><strong>App functionality</strong>: Restoring the puzzle you were solving (entered digits and notes, undo and redo history, selected cell), keeping puzzle-pack progress and My Puzzles, and remembering your settings — all handled only on the device and never sent to us.</li>
          <li><strong>Customer support</strong>: Receiving and answering inquiries you send by email and letting you know the outcome</li>
        </ul>

        <h2>2. Information We Process</h2>
        <p>The App does not require sign-up. The information the App stores on your device, and the information we receive to answer inquiries, is as follows.</p>
        <ScrollableLegalTable label="Privacy information table; scroll horizontally">
        <table>
          <thead>
            <tr>
              <th>Category</th>
              <th>Items</th>
              <th>Method · Where it lives</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Game records</td>
              <td>The puzzle in progress, entered digits and notes (candidates), undo and redo history, selected cell, puzzle-pack progress</td>
              <td>Stored only in the App's private storage on the device. Never sent to us, and we cannot see it</td>
            </tr>
            <tr>
              <td>My Puzzles</td>
              <td>The given digits of puzzles you enter yourself and an optional title (up to 40 characters); up to 100 puzzles</td>
              <td>Stored only in the App's private storage on the device. Never sent to us, and we cannot see it</td>
            </tr>
            <tr>
              <td>App settings</td>
              <td>Auto-Clear Related Notes, Haptic Feedback, Background Theme (Paper, Garden, Night), Appearance</td>
              <td>Stored only in the App's private storage on the device. Never sent to us, and we cannot see it</td>
            </tr>
            <tr>
              <td>Email inquiries</td>
              <td>Email address, name (optional), message</td>
              <td>Collected only when you email our support or privacy address directly</td>
            </tr>
          </tbody>
        </table>
        </ScrollableLegalTable>

        <h2>3. Retention Period</h2>
        <ul>
          <li><strong>Game records, My Puzzles and app settings (on the device)</strong>: Kept on the device until you delete the App, and deleted along with it. Whether they are included in device backups depends on your iOS backup settings.</li>
          <li><strong>Email inquiry records</strong>: <strong>3 years</strong> after the inquiry is resolved</li>
        </ul>

        <h2>4. Disclosure to Third Parties</h2>
        <p>We do not provide your personal data to third parties, except with your consent or where required by law (Articles 17 and 18 of the Korean Personal Information Protection Act).</p>

        <h2>5. Processing Entrustment</h2>
        <p>We do not entrust the processing of personal data related to the App to any other party.</p>

        <h2>6. International Data Transfers</h2>
        <p>We do not transfer personal data related to the App to other countries. The App does not send the information it stores off your device.</p>

        <h2>7. Information Handled by Apple</h2>
        <p>App Store downloads of the App, crash and diagnostic reports you choose to share with app developers, and TestFlight feedback are handled by Apple under <a href="https://www.apple.com/legal/privacy/" target="_blank" rel="noopener">Apple's Privacy Policy</a>.</p>

        <h2>8. App Permissions</h2>
        <p>The App requests no device permissions. It does not ask for location, camera, microphone, contacts, photos or notifications access, and it does not show the App Tracking Transparency prompt.</p>

        <h2>9. Data Destruction</h2>
        <ul>
          <li><strong>Procedure</strong>: Personal data that is no longer needed, for example because its retention period has ended, is destroyed without delay with the approval of the data protection officer.</li>
          <li><strong>Method</strong>: Electronic files are permanently deleted so they cannot be recovered. Game records, My Puzzles and app settings are removed from the device when you delete the App.</li>
        </ul>


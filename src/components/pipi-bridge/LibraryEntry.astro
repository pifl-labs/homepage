      </div>
      <a class="app-bridge-resource-link" href="/en/apps/pipi-bridge/library/" hreflang="en">
        <span>Open the guide</span><i class="fas fa-arrow-right" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</section>

---
import { appIconSrc } from "../data/app-icons.mjs";
// 홈 앱 카탈로그 — 카드 그리드 + 스토어 직행 링크.
// 3언어 index.astro 가 마크업을 3중 복제하던 것을 한 곳으로 모은다(드리프트 방지).
// 카피는 lang 별 map, 나머지는 전부 apps.ts 파생.
import {
  appList, appName, displayVersion, releaseVersionLabel, formatDate, latestUpdate, previousNameLabels, storeAppName,
  statusLabels, storeLabels, updatedLabels,
} from '../data/apps';
import { catalogCopy } from '../data/app-catalog';
import StoreNameNotice from './StoreNameNotice.astro';
import { japaneseAppNameParts, japaneseReadingParts } from './app-name-parts.mjs';
import type { Lang } from '../i18n/ui';
import { storeUrl, websiteCampaign } from '../../public/store-attribution.mjs';

interface Props { lang: Lang }
const { lang } = Astro.props;
const campaign = websiteCampaign(lang);
const sl = storeLabels[lang];
const ul = updatedLabels[lang];

const copy = {
  ko: {
    kicker: '00 / 함대',
    title: '작은 함대,',
    titleEm: '이미 바다 위.',
    // 서사 규칙: 제작 주체는 사람, PiPi 는 동행자 (AI 저작 주장은 crew·about 에서만)
    sub: '집중, 그림, 배움, 기록. 지금 하고 싶은 일에 맞는 앱을 골라 보세요.',
    iconAlt: (n: string) => `${n} 아이콘`,
  },
  ja: {
    kicker: '00 / 艦隊',
    title: '小さな艦隊、',
    titleEm: 'もう海の上。',
    sub: '集中、お絵描き、学び、記録。今やりたいことに合うアプリを見つけよう。',
    iconAlt: (n: string) => `${n} アイコン`,
  },
  en: {
    kicker: '00 / Fleet',
    title: 'A small fleet,',
    titleEm: 'already at sea.',
    sub: 'Focus, create, learn or reflect. Find the app for what you want to do today.',
    iconAlt: (n: string) => `${n} icon`,
  },
}[lang];
---
<section class="apps-home" id="apps">
  <div class="container">
    <div class="section-head">
      <div class="kicker">{copy.kicker}</div>
      <h2 class="section-title">{copy.title} <span class="italic">{copy.titleEm}</span></h2>
      <p class="section-sub">{copy.sub}</p>
    </div>

    <div class="app-card-grid">
      {appList.map((app) => {
        const name = appName(app, lang);
        return (
          <article class:list={["app-card", { "app-card--soon": app.status === "soon" }]}>
            <a class="app-card-main" href={`/${lang}/apps/${app.slug}/`}>
              <img class="app-card-icon" src={appIconSrc(app.slug)} alt="" width="64" height="64" loading="lazy" />
              <div class="app-card-head">
                  <span class="app-card-name">{lang === 'ja' ? japaneseAppNameParts(name).map((part: { text: string; keepWhole: boolean }) => part.keepWhole ? <span class="app-name-part ja-reading-unit">{part.text}</span> : part.text) : name}</span>
                  <span class={`app-card-status app-card-status--${app.status}`}>{statusLabels[lang][app.status]}</span>
                </div>
              <div class="app-card-body">
                {app.previousName && <span class="app-previous-name">{previousNameLabels[lang]} {app.previousName}</span>}
                <span class="app-card-cat">{lang === 'ja' ? japaneseReadingParts(app.category[lang], 'category').map(part => part.keepWhole ? <span class="ja-reading-unit">{part.text}</span> : part.text) : app.category[lang]}</span>
                <p class="app-card-tag">{catalogCopy[app.slug][lang]}</p>
                <span class="app-card-detail">{({ ko: "앱 자세히 보기", ja: "アプリの詳細", en: "Explore app" })[lang]} <span aria-hidden="true">→</span></span>
              </div>
              {app.status === 'live' && <figure class="app-card-preview">
                <img src={`/assets/apps/${app.slug}/${lang}/store-preview.webp`} alt="" width="480" height="1040" loading="lazy" />
                <figcaption>{({ ko: '공식 스토어 화면', ja: '公式ストアの画面', en: 'Official store preview' })[lang]}</figcaption>
              </figure>}
            </a>

            {app.status === 'live' && (app.stores.ios || app.stores.android) && (
              <div class="app-card-stores">
                {app.stores.ios && (
                  <a class="app-card-store" href={storeUrl(app.stores.ios, campaign)} data-store-link={app.stores.ios} target="_blank" rel="noopener" aria-label={`${storeAppName(app, 'ios', lang)} — ${sl.onIos}`}>
                    <i class="fab fa-apple" aria-hidden="true"></i> {sl.ios}
                  </a>
                )}
                {app.stores.android && (
                  <a class="app-card-store" href={storeUrl(app.stores.android, campaign)} data-store-link={app.stores.android} target="_blank" rel="noopener" aria-label={`${storeAppName(app, 'android', lang)} — ${sl.onAndroid}`}>
                    <i class="fab fa-google-play" aria-hidden="true"></i> {sl.android}
                  </a>
                )}
              </div>
            )}
            <StoreNameNotice app={app} lang={lang} compact />
          </article>
        );
      })}
    </div>
  </div>
</section>

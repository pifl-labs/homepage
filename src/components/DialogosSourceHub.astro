---
// 출처 라이브러리 허브(목차) — [개별 출처 ↔ 허브 ↔ 앱 소개]를 잇는 다리.
// 데이터(dialogos-sources.ts)에서 멘토별로 그룹화해 자동 생성.
import BaseLayout from '../layouts/BaseLayout.astro';
import { sourceList } from '../data/dialogos-sources';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const labels = {
  ko: {
    title: '출처 라이브러리',
    lede: 'Dialogos의 철학자들이 답할 때 인용하는 퍼블릭 도메인 고대 원전 모음. 각 작품의 해설과 무료 원문 링크를 제공합니다.',
    intro: 'Dialogos는 저작권이 만료된 원전(퍼블릭 도메인)만을 출처로 인용합니다. 아래는 멘토별 인용 원전 목록입니다.',
    toApp: 'Dialogos 앱 보기', read: '자세히 보기',
  },
  ja: {
    title: '出典ライブラリ',
    lede: 'Dialogos の賢者たちが答える際に引用するパブリックドメインの古典原典の一覧。各作品の解説と無料原文へのリンクを提供します。',
    intro: 'Dialogos は著作権が切れた原典(パブリックドメイン)のみを出典として引用します。以下はメンター別の引用原典一覧です。',
    toApp: 'Dialogos アプリを見る', read: '詳しく見る',
  },
  en: {
    title: 'Source Library',
    lede: 'The public-domain ancient texts the sages of Dialogos cite when they answer you. Each work includes an overview and links to the free original.',
    intro: 'Dialogos cites only public-domain originals (out of copyright). Below are the cited works, grouped by mentor.',
    toApp: 'View the Dialogos app', read: 'Read more',
  },
}[lang];

// 입문 읽는 순서 — "어디서부터 읽을까(入門 順番)" 검색 유입 대응. 저작 횡단(언어 무관 순서 + 언어별 이유).
// 작품명·멘토명은 sourceList에서 동적으로 가져와 데이터 일관성을 보장한다.
const readingPath = {
  ko: {
    title: '어디서부터 읽을까 — 스토아 입문 순서',
    intro: '여덟 권을 다 읽을 필요는 없습니다. 처음이라면 이 순서를 권합니다.',
    steps: [
      { slug: 'enchiridion', why: '가장 짧고 실천적인 한 권. “내가 통제할 수 있는 것”이라는 스토아의 핵심을 단숨에 잡습니다.' },
      { slug: 'meditations', why: '로마 황제가 자신에게 쓴 일기. 가장 널리 사랑받는 입문서입니다.' },
      { slug: 'on-the-shortness-of-life', why: '짧은 에세이 한 편. 시간을 어떻게 쓸지 오늘 바로 적용됩니다.' },
      { slug: 'discourses', why: '엥케이리디온의 모체가 된 강의록. 한 걸음 더 깊이 들어갑니다.' },
      { slug: 'plato-apology', why: '스토아가 뿌리를 둔 소크라테스의 문답. 철학적 용기의 원형입니다.' },
    ],
  },
  ja: {
    title: 'どこから読むか — ストア哲学 入門の順番',
    intro: '八冊すべてを読む必要はありません。初めてなら、この順番をおすすめします。',
    steps: [
      { slug: 'enchiridion', why: '最も短く実践的な一冊。「自分に統制できるもの」というストアの核心を一気につかめます。' },
      { slug: 'meditations', why: 'ローマ皇帝が自らに書いた日記。最も広く愛される入門書です。' },
      { slug: 'on-the-shortness-of-life', why: '短いエッセイ一篇。時間の使い方が今日すぐに変わります。' },
      { slug: 'discourses', why: '『要録』のもとになった講義録。さらに一歩深く入ります。' },
      { slug: 'plato-apology', why: 'ストア派が源流とするソクラテスの問答。哲学的な勇気の原型です。' },
    ],
  },
  en: {
    title: 'Where to start — a reading path into Stoicism',
    intro: 'You do not need to read all eight. If you are new, this is the order we suggest.',
    steps: [
      { slug: 'enchiridion', why: 'The shortest, most practical book — the Stoic core of “what is up to you,” in one sitting.' },
      { slug: 'meditations', why: 'A Roman emperor’s diary to himself. The most widely loved entry point.' },
      { slug: 'on-the-shortness-of-life', why: 'A single short essay; it changes how you spend today.' },
      { slug: 'discourses', why: 'The lectures behind the Enchiridion — going one step deeper.' },
      { slug: 'plato-apology', why: 'The Socratic questioning Stoicism springs from — the archetype of philosophical courage.' },
    ],
  },
}[lang];

const base = `/${lang}`;
const selfPath = `/apps/dialogos/sources/`;
const appHref = `${base}/apps/dialogos/`;
const homeHref = `${base}/`;
const selfUrl = `https://pifl-labs.com${base}${selfPath}`;

const mentorOrder = ['marcus', 'seneca', 'epictetus', 'socrates'];
const groups = mentorOrder
  .map((mid) => ({ mid, works: sourceList.filter((w) => w.mentorId === mid) }))
  .filter((g) => g.works.length > 0)
  .map((g) => ({ mentorName: g.works[0].content[lang].mentorName, works: g.works }));

const alternates = [
  { hreflang: 'en', href: `https://pifl-labs.com/en${selfPath}` },
  { hreflang: 'ko', href: `https://pifl-labs.com/ko${selfPath}` },
  { hreflang: 'ja', href: `https://pifl-labs.com/ja${selfPath}` },
  { hreflang: 'x-default', href: `https://pifl-labs.com/ko${selfPath}` },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: labels.title,
    description: labels.lede,
    inLanguage: lang,
    url: selfUrl,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: sourceList.map((w, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: w.content[lang].workName,
        url: `https://pifl-labs.com${base}/apps/dialogos/sources/${w.slug}/`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: lang === 'ja' ? 'ホーム' : lang === 'en' ? 'Home' : '홈', item: `https://pifl-labs.com${homeHref}` },
      { '@type': 'ListItem', position: 2, name: 'Dialogos', item: `https://pifl-labs.com${appHref}` },
      { '@type': 'ListItem', position: 3, name: labels.title, item: selfUrl },
    ],
  },
];

const title = `${labels.title} — Dialogos | PiFl Labs`;
---
<BaseLayout
  lang={lang}
  title={title}
  description={labels.lede}
  canonical={selfUrl}
  alternates={alternates}
  extraCss={['/styles.css']}
>
  {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}

  <section class="legal-hero">
    <div class="container">
      <nav class="src-crumb" aria-label="breadcrumb">
        <a href={appHref}>Dialogos</a><span aria-hidden="true">›</span>
        <span aria-current="page">{labels.title}</span>
      </nav>
      <h1><i class="fas fa-book-open"></i> <span class="text-gradient">{labels.title}</span></h1>
      <p class="legal-date">{labels.intro}</p>
    </div>
  </section>

  <main class="legal-page">
    <div class="container">
      {groups.map((g) => (
        <section class="src-group">
          <h2 class="src-group-title">{g.mentorName}</h2>
          <div class="src-grid">
            {g.works.map((w) => (
              <a class="src-card" href={`${base}/apps/dialogos/sources/${w.slug}/`}>
                <i class={`fas ${w.icon} src-card-icon`}></i>
                <span class="src-card-name">{w.content[lang].workName}</span>
                <span class="src-card-lede">{w.content[lang].lede}</span>
                <span class="src-card-more">{labels.read} →</span>
              </a>
            ))}
          </div>
        </section>
      ))}

      <section class="src-path">
        <h2 class="src-group-title">{readingPath.title}</h2>
        <p class="src-path-intro">{readingPath.intro}</p>
        <ol class="src-path-list">
          {readingPath.steps.map((s) => {
            const w = sourceList.find((x) => x.slug === s.slug);
            return (
              <li class="src-path-step">
                <a class="src-path-link" href={`${base}/apps/dialogos/sources/${s.slug}/`}>
                  {w ? `${w.content[lang].workName} · ${w.content[lang].mentorName}` : s.slug}
                </a>
                <span class="src-path-why">{s.why}</span>
              </li>
            );
          })}
        </ol>
      </section>

      <div class="src-hub-cta">
        <a class="src-nav-btn src-nav-btn--cta" href={appHref}>{labels.toApp} <i class="fas fa-arrow-right"></i></a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .src-crumb {
    display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center;
    font-size: 0.8rem; color: var(--text-muted); margin-bottom: var(--s-sm);
  }
  .src-crumb a { color: var(--text-secondary); text-decoration: none; }
  .src-crumb a:hover { color: var(--text-primary); }
  .src-crumb span { color: var(--text-dim); }

  .src-group { margin-bottom: var(--s-md); }
  .src-group-title {
    font-size: 1.1rem; color: var(--text-primary);
    margin-bottom: var(--s-sm); padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border-default);
  }

  .src-grid {
    display: grid; gap: var(--s-sm);
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }
  .src-card {
    display: flex; flex-direction: column; gap: 0.4rem;
    padding: var(--s-sm); border: 1px solid var(--border-default);
    border-radius: var(--radius-md); background: var(--bg-card);
    text-decoration: none; transition: border-color 0.15s, transform 0.15s;
  }
  .src-card:hover { border-color: var(--accent-cta); transform: translateY(-2px); }
  .src-card-icon { color: var(--accent-highlight); font-size: 1.2rem; }
  .src-card-name { font-weight: 700; color: var(--text-primary); font-size: 1rem; }
  .src-card-lede { color: var(--text-secondary); font-size: 0.82rem; line-height: 1.5; }
  .src-card-more { color: var(--accent-cta); font-size: 0.8rem; font-weight: 600; margin-top: auto; }

  /* 입문 읽는 순서 (readingPath) */
  .src-path { margin: var(--s-md) 0; }
  .src-path-intro { color: var(--text-secondary); font-size: 0.92rem; line-height: 1.6; margin: 0 0 var(--s-sm); }
  .src-path-list { margin: 0; padding-left: 1.4rem; display: grid; gap: 0.7rem; }
  .src-path-step { line-height: 1.5; }
  .src-path-link { display: inline-block; font-weight: 700; color: var(--text-primary); text-decoration: none; }
  .src-path-link:hover { color: var(--accent-cta); }
  .src-path-why { display: block; color: var(--text-secondary); font-size: 0.88rem; line-height: 1.55; margin-top: 0.15rem; }

  .src-hub-cta { display: flex; justify-content: center; margin-top: var(--s-md); }
  .src-nav-btn {
    display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.7rem 1.4rem;
    border-radius: var(--radius-pill); text-decoration: none; font-size: 0.95rem;
  }
  .src-nav-btn--cta { background: var(--gradient-cta); border: none; color: #fff; }
</style>

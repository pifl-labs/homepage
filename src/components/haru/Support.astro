---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../i18n/ui';

interface Props { lang?: Lang; homeHref?: string }
// 하루의 계절(com.pifl.pipi.haru, App Store 6832961707) 지원 페이지 — 앱 주소(/apps/haru/) 자체가 지원 페이지다.
// 출시 전이라 스토어 링크를 두지 않고, apps.ts·홈 카탈로그에도 올리지 않는다(방침·지원만 있는 앱, check-site-facts 경고 대상).
// 게임은 한국어 전용이지만 지원·방침은 형제 앱처럼 ko·en·ja 로케일 경로마다 그 언어 본문 하나만 서빙한다
// (자기 canonical + ko/en/ja alternate, x-default 는 사이트 규칙대로 /ko/). 무prefix 경로는 영어 본문(canonical /en/).
// 앱 화면 문구(버튼·메뉴)는 haru 저장소 season/scripts/app 의 글자 그대로 쓴다:
//   기록 → 설정 → 구매 → '구매 복원'(tab_purchase.gd) · 팩 안내 '더 고운 그림을 받을게요' [받기] [나중에](pack_prompt.gd).
// en·ja 판은 한국어 화면 문구를 그대로 두고 괄호로 뜻을 붙인다(앱이 한국어로만 표시되므로). 한국어 문구는 lang="ko" 로 감싸
// 화면 읽기 기능이 한국어로 읽게 한다. 앱 이름은 '하루의 계절' 하나라 번역 이름을 붙이지 않고, 제목의 뜻은 소개에서 한 번만 풀이한다.
// 구매: 엔딩 화면·새 이야기 시트의 사기 버튼은 첫 엔딩 뒤, 기록 → 설정 → 구매의 사기 버튼은 첫 엔딩 전에도 보이고
// 그때 사면 지금 판에 바로 열린다(b19 fcd2b83 tab_purchase.gd · dream_gate.gd sync · DESIGN §13.5).
const { lang = 'ko', homeHref = `/${lang}/` } = Astro.props;

const BASE = 'https://pifl-labs.com';
const PATH = '/apps/haru/';
const canonical = `${BASE}/${lang}${PATH}`;
const alternates = [
  { hreflang: 'en', href: `${BASE}/en${PATH}` },
  { hreflang: 'ko', href: `${BASE}/ko${PATH}` },
  { hreflang: 'ja', href: `${BASE}/ja${PATH}` },
  { hreflang: 'x-default', href: `${BASE}/ko${PATH}` },
];

const chrome = {
  ko: {
    docTitle: '하루의 계절 지원 - PiFl Labs',
    docDesc: '육성 시뮬레이션 게임 하루의 계절의 게임 소개, 자주 묻는 질문과 지원 문의 안내입니다.',
    back: '홈으로 돌아가기',
    titleTail: '지원',
    sub: '게임 소개 · 자주 묻는 질문 · 문의',
  },
  en: {
    docTitle: '하루의 계절 Support - PiFl Labs',
    docDesc: 'About 하루의 계절, a Korean-language life-sim game: frequently asked questions and how to contact support.',
    back: 'Back to Home',
    titleTail: 'Support',
    sub: 'About the game · FAQ · Contact',
  },
  ja: {
    docTitle: '하루의 계절 サポート - PiFl Labs',
    docDesc: '韓国語の育成シミュレーションゲーム「하루의 계절」のゲーム紹介、よくある質問、サポートへのお問い合わせ方法のご案内です。',
    back: 'ホームに戻る',
    titleTail: 'サポート',
    sub: 'ゲーム紹介 · よくある質問 · お問い合わせ',
  },
}[lang];
---
<BaseLayout
  lang={lang}
  title={chrome.docTitle}
  description={chrome.docDesc}
  canonical={canonical}
  alternates={alternates}
  extraCss={["/styles.css"]}
>
  <section class="legal-hero">
    <div class="container">
      <a href={homeHref} class="legal-back"><i class="fas fa-arrow-left" aria-hidden="true"></i> {chrome.back}</a>
      <h1><i class="fas fa-life-ring" aria-hidden="true"></i> <span class="text-gradient"><span lang="ko">하루의 계절</span> {chrome.titleTail}</span></h1>
      <p class="legal-date">{chrome.sub}</p>
    </div>
  </section>

  <main id="main" class="legal-page">
    <div class="container support-grid">
      {lang === 'ko' && (
      <>
      <article class="legal-card support-card">
        <p class="section-label">게임 소개</p>
        <h2>하루의 계절</h2>
        <p>여섯 살 봄부터 열일곱 살 겨울까지, 하루와 함께 바다 마을의 48계절을 보내는 육성 시뮬레이션이에요.</p>
        <p>계절마다 수업·일하기·쉬기 가운데 일정 세 칸을 짜서 하루를 키워요. 가을에는 축제 대회에 나가고, 이야기 속 선택으로 하루의 길을 함께 정해요.</p>
        <p>열여덟 살이 되면 그동안 자란 모습에 따라 엔딩을 맞아요. 본 엔딩은 새 이야기를 시작해도 엔딩 앨범에 남아요.</p>
        <p class="support-note">게임은 한국어로만 제공돼요.</p>
      </article>

      <article class="legal-card support-card">
        <p class="section-label">구매</p>
        <h2>첫 이야기는 무료예요</h2>
        <p>첫 이야기는 엔딩까지 무료로 즐길 수 있어요. 광고는 없어요.</p>
        <p>첫 엔딩을 본 뒤 <strong>'새 꿈 묶음'</strong>(₩5,500, 한 번 구매)을 사면 두 번째 이야기부터 숨은 꿈 6가지를 고를 수 있어요.</p>
        <p><strong>기록 → 설정 → 구매</strong>에서는 첫 엔딩 전에도 살 수 있어요. 그때 사면 지금 이야기에서 바로 숨은 꿈이 열려요.</p>
      </article>

      <article class="legal-card support-card">
        <p class="section-label">빠른 해결</p>
        <h2>자주 묻는 질문</h2>

        <h3>게임 진행은 어디에 저장되나요?</h3>
        <p>진행 중인 이야기와 엔딩 앨범, 설정은 이 기기 안에만 저장돼요. 회사 서버에 저장하거나 다른 기기와 동기화하지 않아서, 앱을 지우면 진행도 함께 사라지고 회사가 되살려 드릴 수 없어요. 산 '새 꿈 묶음'은 아래 '구매 복원'으로 되찾을 수 있어요.</p>

        <h3>처음 켰을 때 그림을 받을지 물어봐요.</h3>
        <p>게임 그림의 많은 부분은 추가 리소스 팩으로 따로 받아요. 처음 켜면 <strong>'더 고운 그림을 받을게요'</strong> 안내에 받을 크기와 'Wi-Fi 권장'이 나와요. <strong>받기</strong>를 누르면 내려받기 시작하고, 받는 동안에도 계속 놀 수 있어요. <strong>나중에</strong>를 누르면 지금 그림으로 계속 놀 수 있고, 다음에 앱을 켤 때 다시 물어봐요.</p>
        <p>받은 팩은 기기의 임시 저장 공간(캐시)에 있어요. 저장 공간이 모자라 시스템이 이 공간을 비우면 다음에 켤 때 다시 물어봐요.</p>

        <h3>구매를 복원하고 싶어요.</h3>
        <p><strong>기록 → 설정 → 구매</strong>에서 <strong>'구매 복원'</strong>을 누르세요. 앱을 다시 설치했거나 다른 기기에서 '새 꿈 묶음'을 되찾을 수 있어요. 구매할 때 쓴 스토어 계정으로 로그인되어 있어야 하며, App Store 계정 확인 창이 뜰 수 있어요.</p>
      </article>

      <article class="legal-card support-card contact-card">
        <p class="section-label">지원 연락처</p>
        <h2>문의</h2>
        <p>문제가 계속되면 아래 내용을 함께 보내 주세요. 원인을 더 빨리 찾을 수 있어요.</p>
        <ul>
          <li>기기 모델과 운영체제 버전</li>
          <li>문제가 생긴 화면과 그때까지 한 순서(예: 하루가 몇 살, 어느 계절일 때)</li>
          <li>가능하면 화면 캡처</li>
        </ul>
        <p class="contact-link"><a href="#" data-email-user="support" data-email-domain="pifl-labs.com"><i class="fas fa-envelope" aria-hidden="true"></i> <span class="email-text">support (at) pifl-labs.com</span></a></p>
        <p>개인정보 관련 문의는 <a href="#" data-email-user="privacy" data-email-domain="pifl-labs.com"><span class="email-text">privacy (at) pifl-labs.com</span></a>로 보내 주세요.</p>
        <p><a href="/ko/apps/haru/privacy/">개인정보처리방침 보기 <i class="fas fa-arrow-right" aria-hidden="true"></i></a></p>
      </article>
      </>
      )}

      {lang === 'en' && (
      <>
      <article class="legal-card support-card">
        <p class="section-label">About the game</p>
        <h2 lang="ko">하루의 계절</h2>
        <p>A life-sim game in which you spend 48 seasons in a seaside town with Haru, from the spring she is six to the winter she is seventeen.</p>
        <p>Each season, you raise Haru by filling three schedule slots with classes, work and rest. In autumn she enters festival contests, and the choices you make in each story help decide her path.</p>
        <p>At eighteen she reaches an ending shaped by how she has grown. Endings you have seen stay in the Ending Album even when you start a new story.</p>
        <p class="support-note">The game is available in Korean only. Its Korean title, <span lang="ko">하루의 계절</span>, means “Haru's seasons.”</p>
      </article>

      <article class="legal-card support-card">
        <p class="section-label">Purchases</p>
        <h2>The first story is free</h2>
        <p>Play the first story all the way to its ending for free. There are no ads.</p>
        <p>After your first ending, a one-time purchase of the <strong lang="ko">새 꿈 묶음</strong> (“New Dreams” bundle, ₩5,500) lets you choose from 6 hidden dreams from your second story on.</p>
        <p>You can also buy it before your first ending in <strong><span lang="ko">기록</span> (Records) → <span lang="ko">설정</span> (Settings) → <span lang="ko">구매</span> (Purchases)</strong>. If you do, the hidden dreams open right away in your current story.</p>
      </article>

      <article class="legal-card support-card">
        <p class="section-label">Quick fixes</p>
        <h2>Frequently Asked Questions</h2>

        <h3>Where is my progress saved?</h3>
        <p>Your current story, Ending Album and settings are saved only on this device. They are not stored on our servers or synced to other devices, so deleting the app also deletes your progress, and we cannot restore it. A <span lang="ko">새 꿈 묶음</span> purchase can be recovered with Restore Purchases (see below).</p>

        <h3>The game asks whether to download artwork when I first open it.</h3>
        <p>Much of the game's artwork comes in additional resource packs that are downloaded separately. The first time you open the game, a prompt titled <strong lang="ko">더 고운 그림을 받을게요</strong> (“Let's get nicer artwork”) shows the download size and recommends Wi-Fi. Tap <strong lang="ko">받기</strong> (Download) to start; you can keep playing while it downloads. Tap <strong lang="ko">나중에</strong> (Later) to keep playing with the current artwork, and the game will ask again the next time you open it.</p>
        <p>Downloaded packs are kept in your device's cache. If the system clears the cache because storage is low, the game will ask again the next time you open it.</p>

        <h3>How do I restore my purchase?</h3>
        <p>Go to <strong><span lang="ko">기록</span> (Records) → <span lang="ko">설정</span> (Settings) → <span lang="ko">구매</span> (Purchases)</strong> and tap <strong lang="ko">구매 복원</strong> (Restore Purchases). This recovers the <span lang="ko">새 꿈 묶음</span> after you reinstall the app or on another device. You need to be signed in with the store account you used to buy it, and an App Store account prompt may appear.</p>
      </article>

      <article class="legal-card support-card contact-card">
        <p class="section-label">Support contact</p>
        <h2>Contact Us</h2>
        <p>If the problem continues, please include the following so we can find the cause faster.</p>
        <ul>
          <li>Your device model and operating system version</li>
          <li>The screen where the problem happened and the steps that led to it (for example, Haru's age and the season)</li>
          <li>A screenshot, if possible</li>
        </ul>
        <p class="contact-link"><a href="#" data-email-user="support" data-email-domain="pifl-labs.com"><i class="fas fa-envelope" aria-hidden="true"></i> <span class="email-text">support (at) pifl-labs.com</span></a></p>
        <p>For privacy questions, email <a href="#" data-email-user="privacy" data-email-domain="pifl-labs.com"><span class="email-text">privacy (at) pifl-labs.com</span></a>.</p>
        <p><a href="/en/apps/haru/privacy/">Read the Privacy Policy <i class="fas fa-arrow-right" aria-hidden="true"></i></a></p>
      </article>
      </>
      )}

      {lang === 'ja' && (
      <>
      <article class="legal-card support-card">
        <p class="section-label">ゲーム紹介</p>
        <h2 lang="ko">하루의 계절</h2>
        <p>6歳の春から17歳の冬まで、海辺の町でハルと48の季節を過ごす育成シミュレーションです。</p>
        <p>季節ごとに授業・仕事・休みから3つの予定を組んで、ハルを育てます。秋には祭りの大会に出場し、物語の中の選択でハルの進む道を一緒に決めていきます。</p>
        <p>18歳になると、それまでの成長に応じたエンディングを迎えます。見たエンディングは、新しい物語を始めてもエンディングアルバムに残ります。</p>
        <p class="support-note">ゲームは韓国語のみの対応です。タイトルの「<span lang="ko">하루의 계절</span>」は「ハルの季節」という意味です。</p>
      </article>

      <article class="legal-card support-card">
        <p class="section-label">購入</p>
        <h2>最初の物語は無料</h2>
        <p>最初の物語はエンディングまで無料で遊べます。広告はありません。</p>
        <p>最初のエンディングを見たあと、<strong>「<span lang="ko">새 꿈 묶음</span>」</strong>（新しい夢のセット、₩5,500・買い切り）を購入すると、2回目の物語から6つの隠れた夢を選べるようになります。</p>
        <p><strong><span lang="ko">기록</span>（記録）→ <span lang="ko">설정</span>（設定）→ <span lang="ko">구매</span>（購入）</strong>では、最初のエンディングの前でも購入できます。その場合は、今の物語からすぐに隠れた夢が開きます。</p>
      </article>

      <article class="legal-card support-card">
        <p class="section-label">すぐに解決</p>
        <h2>よくある質問</h2>

        <h3>進行状況はどこに保存されますか？</h3>
        <p>進行中の物語、エンディングアルバム、設定はこの端末の中にだけ保存されます。当社のサーバーに保存したり、ほかの端末と同期したりはしないため、アプリを削除すると進行状況も消え、当社で元に戻すことはできません。購入した「<span lang="ko">새 꿈 묶음</span>」は、下の「購入の復元」で取り戻せます。</p>

        <h3>初めて起動したとき、絵をダウンロードするか聞かれます。</h3>
        <p>ゲームの絵の多くは、追加リソースパックとして別にダウンロードします。初めて起動すると<strong>「<span lang="ko">더 고운 그림을 받을게요</span>」</strong>（もっときれいな絵を受け取ります）という案内に、ダウンロードするサイズと「Wi-Fi推奨」が表示されます。<strong>「<span lang="ko">받기</span>」</strong>（受け取る）を押すとダウンロードが始まり、その間も遊び続けられます。<strong>「<span lang="ko">나중에</span>」</strong>（あとで）を押すと今の絵のまま遊び続けられ、次にアプリを起動したときにもう一度聞かれます。</p>
        <p>ダウンロードしたパックは端末のキャッシュに保存されます。空き容量が足りずシステムがキャッシュを消去した場合は、次に起動したときにもう一度聞かれます。</p>

        <h3>購入を復元したいです。</h3>
        <p><strong><span lang="ko">기록</span>（記録）→ <span lang="ko">설정</span>（設定）→ <span lang="ko">구매</span>（購入）</strong>で<strong>「<span lang="ko">구매 복원</span>」</strong>（購入の復元）を押してください。アプリを再インストールしたときや別の端末で「<span lang="ko">새 꿈 묶음</span>」を取り戻せます。購入時と同じストアのアカウントでサインインしている必要があり、App Storeのアカウント確認画面が表示されることがあります。</p>
      </article>

      <article class="legal-card support-card contact-card">
        <p class="section-label">お問い合わせ先</p>
        <h2>お問い合わせ</h2>
        <p>問題が解決しない場合は、次の情報を添えてご連絡ください。原因をより早く確認できます。</p>
        <ul>
          <li>端末のモデルとOSのバージョン</li>
          <li>問題が起きた画面と、そこまでの操作手順（例: ハルが何歳のどの季節か）</li>
          <li>可能であれば、画面のスクリーンショット</li>
        </ul>
        <p class="contact-link"><a href="#" data-email-user="support" data-email-domain="pifl-labs.com"><i class="fas fa-envelope" aria-hidden="true"></i> <span class="email-text">support (at) pifl-labs.com</span></a></p>
        <p>個人情報に関するお問い合わせは <a href="#" data-email-user="privacy" data-email-domain="pifl-labs.com"><span class="email-text">privacy (at) pifl-labs.com</span></a> までお送りください。</p>
        <p><a href="/ja/apps/haru/privacy/">プライバシーポリシーを見る <i class="fas fa-arrow-right" aria-hidden="true"></i></a></p>
      </article>
      </>
      )}
    </div>
  </main>

  <style>
    /* 한국어 본문만 어절 단위로 줄바꿈한다(영어·일본어는 기본 규칙). */
    .legal-hero h1:lang(ko), .legal-card:lang(ko) { overflow-wrap: break-word; word-break: keep-all; }
    .support-grid { display: grid; gap: 1.25rem; }
    .support-card h2 { margin-top: 0; }
    .support-card h3 { font-size: 1.08rem; margin-top: 1.6rem; }
    .support-card li + li { margin-top: .55rem; }
    /* 첫 문단 리드 스타일(.legal-card > p:first-child)을 눈썹 라벨에서 걷어낸다. */
    .support-card > .section-label { border-bottom: 0; color: var(--accent-highlight); font-size: .85rem; font-weight: 900; letter-spacing: .08em; line-height: 1.4; margin-bottom: .35rem; padding-bottom: 0; }
    .support-note { color: var(--text-secondary); font-size: .95rem; }
    .contact-card { border-color: var(--border-strong); }
    .contact-link a { align-items: center; background: var(--navy); border: 1px solid var(--border-strong); border-radius: var(--radius-pill); color: var(--text-primary); display: inline-flex; font-weight: 800; gap: .55rem; padding: .75rem 1.1rem; text-decoration: none; }
    .contact-link a:hover { border-color: var(--accent-warm); transform: translateY(-1px); }
  </style>
</BaseLayout>

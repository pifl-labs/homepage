# Cloudflare Pages 헤더 — 기존 firebase.json 보안 헤더 이식
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin

# 폰트·이미지 — 장기 캐시 (파일명 고정 자산)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 루트 CSS·JS — 파일명 고정(비해시) 자산이라 짧은 캐시 + 재검증.
# (Firebase 시절 max-age=31536000 으로 캐시돼 컷오버 후 stale 서빙된 사고 재발 방지)
/*.css
  Cache-Control: public, max-age=3600, must-revalidate
/*.js
  Cache-Control: public, max-age=3600, must-revalidate

# 모바일 딥링크 검증 파일 (Universal Links / App Links)
# AASA는 확장자가 없어 기본 Content-Type이 application/json이 아님 → Apple CDN이 거부.
# 반드시 application/json으로 강제하고 리다이렉트가 끼지 않게 한다(미들웨어 우회와 한 쌍).
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600

# SEO 자산 — 짧은 캐시
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap-index.xml
  Cache-Control: public, max-age=3600
/sitemap-0.xml
  Cache-Control: public, max-age=3600

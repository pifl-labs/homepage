{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "astro-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["astro", "dev", "--port", "4321"],
      "port": 4321
    },
    {
      "name": "http-server",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["http-server", "public", "-p", "8000", "-c-1"],
      "port": 8000
    },
    {
      "name": "firebase-hosting",
      "runtimeExecutable": "firebase",
      "runtimeArgs": ["serve", "--only", "hosting", "--port", "5000"],
      "port": 5000
    }
  ]
}
